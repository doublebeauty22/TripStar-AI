
# LLM配置 (从HelloAgents继承,如需覆盖可在此配置)
# 模型名称
LLM_MODEL_ID=your-model-name

# API密钥
LLM_API_KEY=your-api-key-here

# 服务地址
LLM_BASE_URL=your-api-base-url

# 超时时间（可选，默认60秒）
LLM_TIMEOUT=60

# 单个 TripPlan 最多允许的逻辑 LLM 调用数（默认5）
MAX_LLM_CALLS_PER_TRIP=5

# 仅对明确的瞬时网络/5xx/rate-limit 错误重试（默认最多1次）
# quota/auth/invalid-request 错误始终不重试。
MAX_TRANSIENT_LLM_RETRIES=1

# Preference 到 Trip task 的 generation usage 内存保留时间（默认1小时）
GENERATION_USAGE_TTL_SECONDS=3600

# 服务器配置
APP_ENV=development
PUBLIC_DEMO_MODE=false
HOST=0.0.0.0
PORT=8000

# CORS配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 日志级别
LOG_LEVEL=INFO

# Planner overall timeout (seconds).
TRIP_PLANNER_TIMEOUT=180

# Single-process public portfolio guards.
PUBLIC_MAX_CONCURRENT_GENERATIONS=1
PUBLIC_GENERATION_COOLDOWN_SECONDS=60
PUBLIC_AUXILIARY_COOLDOWN_SECONDS=10
PUBLIC_HISTORY_ENABLED=false

# 小红书 Cookie
# 直接填浏览器请求头中的 Cookie 字符串，例如:
# XHS_COOKIE="a1=xxx; web_session=xxx; webId=xxx"
# 也兼容浏览器导出的 JSON Cookie 列表/对象串，程序会自动转换。
XHS_COOKIE="这里填写您网页端登录小红书复制来的 Cookie"

# 高德 Web Service Key（后端 secret）。
AMAP_WEB_SERVICE_KEY=

# Google Maps API 配置 (可选, 填写后优先使用 Google Maps，留空则使用高德)
# 后端专用 Server Key：Places API (New)、Geocoding API、Directions API。
# 不要使用 VITE_ 前缀，不要提交真实 Key。
GOOGLE_MAPS_SERVER_API_KEY=

# Google Maps 代理 (可选, 国内环境需要代理才能访问 Google API)
# 支持 HTTP/HTTPS 代理和 SOCKS5 代理，示例:
#   GOOGLE_MAPS_PROXY=http://127.0.0.1:7890
#   GOOGLE_MAPS_PROXY=socks5://127.0.0.1:1080
GOOGLE_MAPS_PROXY=
