# 后端API地址
VITE_API_BASE_URL=http://localhost:8000

# 浏览器专用 Key：仅用于 Maps JavaScript API / 当前前端 DirectionsService。
# 请配置 HTTP referrer restriction，不要填写 Server Key。
VITE_GOOGLE_MAPS_BROWSER_KEY=

# 高德地图Web端JS API Key
VITE_AMAP_WEB_JS_KEY=your_amap_web_js_key_here

# Public portfolio builds hide local runtime settings and shared history UI.
VITE_PUBLIC_DEMO_MODE=false
